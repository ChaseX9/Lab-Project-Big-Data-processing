# Copy this file to `.env` and adjust the values to your machine.
# Docker Compose reads `.env` automatically.

# Memory given to the Spark driver (local mode runs everything in the driver).
# Keep it below the memory allocated to Docker Desktop.
SPARK_DRIVER_MEMORY=6g

# Number of partitions used for shuffles (joins, groupBy).
SPARK_SHUFFLE_PARTITIONS=64

# Linux/macOS only: your user and group ids, so files written in ./data
# belong to you. Run `id -u` and `id -g` to get them.
# UID=1000
# GID=1000
